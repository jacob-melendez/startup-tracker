# Copy to `.env` and adjust. `.env` is git-ignored.

# Postgres 16 container (docker-compose.yml). Compose reads these.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
# Host-side port mapping only. If you change it, change the port in DATABASE_URL and
# TEST_DATABASE_URL below as well (inside Compose the app always reaches the server at db:5432).
POSTGRES_PORT=5432

# Async SQLAlchemy URL — asyncpg driver, Postgres only (SPEC §3; no SQLite fallback).
# Inside Compose the `app` service overrides the host to `db`.
DATABASE_URL=postgresql+asyncpg://tracker:tracker@localhost:5432/tracker

# structlog: level, and JSON (true) or human-readable console (false) output. Logs go to stderr.
LOG_LEVEL=INFO
LOG_JSON=true

# Tests. Leave unset to have pytest start a disposable postgres:16 container via testcontainers
# (needs Docker). Set it here or in the environment to reuse the Compose server instead: the
# database is created if missing, its name must end in `_test`, and its `public` schema is
# dropped on every run.
# TEST_DATABASE_URL=postgresql+asyncpg://tracker:tracker@localhost:5432/tracker_test
